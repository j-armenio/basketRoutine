{
  "expo": {
    "name": "Basket Routine",
    "slug": "basket-routine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "basketroutine",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1E1E24",
    "platforms": ["android"],
    "android": {
      "package": "com.jarmenio.basketroutine",
      "backgroundColor": "#1E1E24",
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1E24",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f353f7f3-8b10-42d6-8da9-c5cbc72d693f"
      }
    },
    "owner": "jarmenio"
  }
}
